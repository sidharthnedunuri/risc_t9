<?xml version="1.0"?>
<robot name="line_follower_robot">

  <link name="base_link">
    <inertial>
      <origin xyz="-0.01 0 0.01" rpy="0 0 0"/>
      <mass value="0.40"/>
      <inertia ixx="7.07e-4" ixy="0" ixz="0" iyy="7.07e-4" iyz="0" izz="1.307e-3"/>
    </inertial>

    <visual>
      <origin xyz="-0.009 0 0.0095" rpy="0 0 0"/>
      <geometry><box size="0.122 0.14 0.003"/></geometry>
      <material name="plate"><color rgba="0.10 0.35 0.15 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.009 0 0.0095" rpy="0 0 0"/>
      <geometry><box size="0.122 0.14 0.003"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.035 0.043 0" rpy="0 0 0"/>
      <geometry><box size="0.010 0.024 0.012"/></geometry>
      <material name="motor"><color rgba="0.95 0.80 0.10 1"/></material>
    </visual>
    <visual>
      <origin xyz="-0.035 -0.043 0" rpy="0 0 0"/>
      <geometry><box size="0.010 0.024 0.012"/></geometry>
      <material name="motor"><color rgba="0.95 0.80 0.10 1"/></material>
    </visual>

    <visual>
      <origin xyz="-0.025 0 0.021" rpy="0 0 0"/>
      <geometry><box size="0.036 0.066 0.020"/></geometry>
      <material name="batt"><color rgba="0.20 0.20 0.65 1"/></material>
    </visual>

    <visual>
      <origin xyz="-0.025 0 0.0318" rpy="0 0 0"/>
      <geometry><box size="0.090 0.070 0.0016"/></geometry>
      <material name="pcb"><color rgba="0.05 0.45 0.20 1"/></material>
    </visual>

    <visual>
      <origin xyz="0.020 0 0.0188" rpy="0 0 0"/>
      <geometry><box size="0.006 0.020 0.0157"/></geometry>
      <material name="plate"><color rgba="0.10 0.35 0.15 1"/></material>
    </visual>
  </link>

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0215" length="0.019"/></geometry>
      <material name="tyre"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0215" length="0.019"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="2.913e-6" ixy="0" ixz="0" iyy="4.62e-6" iyz="0" izz="2.913e-6"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.035 0.0645 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0215" length="0.019"/></geometry>
      <material name="tyre"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0215" length="0.019"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="2.913e-6" ixy="0" ixz="0" iyy="4.62e-6" iyz="0" izz="2.913e-6"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.035 -0.0645 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_caster">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="4e-7" ixy="0" ixz="0" iyy="4e-7" iyz="0" izz="4e-7"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="metal"><color rgba="0.70 0.70 0.70 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.0095" rpy="0 0 0"/>
      <geometry><cylinder radius="0.003" length="0.019"/></geometry>
      <material name="metal"><color rgba="0.70 0.70 0.70 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.01"/></geometry>
    </collision>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.04 0 -0.011" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <geometry><box size="0.006 0.03312 0.02305"/></geometry>
      <material name="cam"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.028 0 0.0372" rpy="0 0.53 0"/>
  </joint>

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="front_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.57</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>1.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.129</wheel_separation>
      <wheel_radius>0.0215</wheel_radius>
      <max_linear_velocity>0.2</max_linear_velocity>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
    </plugin>
  </gazebo>

</robot>
