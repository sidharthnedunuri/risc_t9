<?xml version="1.0"?>
<robot name="line_follower_robot">

  <material name="chassis_gray">
    <color rgba="0.15 0.16 0.18 1.0"/>
  </material>
  <material name="tyre_black">
    <color rgba="0.03 0.03 0.03 1.0"/>
  </material>
  <material name="text_white">
    <color rgba="0.98 0.98 0.98 1.0"/>
  </material>
  <material name="mast_silver">
    <color rgba="0.65 0.67 0.7 1.0"/>
  </material>
  <material name="lens_blue">
    <color rgba="0.1 0.2 0.6 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.12 0.04"/>
      </geometry>
      <material name="chassis_gray"/>
    </visual>
    <visual>
      <origin xyz="0.022 0.025 0.021" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.03 0.002"/>
      </geometry>
      <material name="text_white"/>
    </visual>
    <visual>
      <origin xyz="0.0 0.025 0.021" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.006 0.002"/>
      </geometry>
      <material name="text_white"/>
    </visual>
    <visual>
      <origin xyz="0.022 -0.025 0.021" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.03 0.002"/>
      </geometry>
      <material name="text_white"/>
    </visual>
    <visual>
      <origin xyz="0.0 -0.025 0.021" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.03 0.002"/>
      </geometry>
      <material name="text_white"/>
    </visual>
    <visual>
      <origin xyz="-0.022 -0.025 0.021" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.03 0.002"/>
      </geometry>
      <material name="text_white"/>
    </visual>
    <visual>
      <origin xyz="0.011 -0.013 0.021" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.006 0.002"/>
      </geometry>
      <material name="text_white"/>
    </visual>
    <visual>
      <origin xyz="0.011 -0.037 0.021" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.006 0.002"/>
      </geometry>
      <material name="text_white"/>
    </visual>
    <visual>
      <origin xyz="-0.011 -0.037 0.021" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.006 0.002"/>
      </geometry>
      <material name="text_white"/>
    </visual>
    <visual>
      <origin xyz="-0.03 0 0.07" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.03 0.10"/>
      </geometry>
      <material name="mast_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.12 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.85"/>
      <inertia ixx="0.001133" ixy="0.0" ixz="0.0" iyy="0.001502" iyz="0.0" izz="0.002408"/>
    </inertial>
  </link>

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.035"/>
      </geometry>
      <material name="tyre_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.000057" ixy="0" ixz="0" iyy="0.000092" iyz="0" izz="0.000057"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.04 0.085 -0.015" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.035"/>
      </geometry>
      <material name="tyre_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.000057" ixy="0" ixz="0" iyy="0.000092" iyz="0" izz="0.000057"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.04 -0.085 -0.015" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="mast_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00000450" ixy="0" ixz="0" iyy="0.00000450" iyz="0" izz="0.00000450"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.055 0 -0.035" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.04 0.03"/>
      </geometry>
      <material name="tyre_black"/>
    </visual>
    <visual>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.01"/>
      </geometry>
      <material name="lens_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.04 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="-0.02 0 0.12" rpy="0 0.44 0"/>
  </joint>

  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="caster_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="line_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.0</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.17</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <topic>cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

</robot>
