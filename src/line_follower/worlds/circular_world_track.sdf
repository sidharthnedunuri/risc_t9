<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="line_follower_hexagon_small">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Disable grid and set solid background -->
    <scene>
      <grid>false</grid>
      <ambient>1 1 1 1</ambient>
      <background>1 1 1 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>1 1 1 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="small_hexagon_track">
      <static>true</static>
      
      <link name="side_1">
        <pose>0.5 0 0.001 0 0 0</pose>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1.15 0.1</size></plane></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0 0 0 1</emissive></material>
        </visual>
      </link>

      <link name="side_2">
        <pose>1.25 0.433 0.001 0 0 1.0472</pose>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1.15 0.1</size></plane></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0 0 0 1</emissive></material>
        </visual>
      </link>

      <link name="side_3">
        <pose>1.25 1.299 0.001 0 0 2.0944</pose>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1.15 0.1</size></plane></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0 0 0 1</emissive></material>
        </visual>
      </link>

      <link name="side_4">
        <pose>0.5 1.732 0.001 0 0 3.1416</pose>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1.15 0.1</size></plane></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0 0 0 1</emissive></material>
        </visual>
      </link>

      <link name="side_5">
        <pose>-0.25 1.299 0.001 0 0 -2.0944</pose>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1.15 0.1</size></plane></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0 0 0 1</emissive></material>
        </visual>
      </link>

      <link name="side_6">
        <pose>-0.25 0.433 0.001 0 0 -1.0472</pose>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1.15 0.1</size></plane></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><emissive>0 0 0 1</emissive></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
